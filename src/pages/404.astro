---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found — Growvidence"
  description="The page you requested could not be found. Return to the Growvidence homepage."
  indexable={false}
>
  <section class="not-found">
    <p class="eyebrow">404 · Not found</p>
    <h1>This page isn't here.</h1>
    <p>The address may have changed, or the page may not exist.</p>
    <a href={import.meta.env.BASE_URL}>Return to Growvidence</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 760px;
    margin: auto;
    padding: 7rem 1.5rem;
  }
  .eyebrow {
    color: #a43618;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  a {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    background: #1c1b19;
    color: white;
    border-radius: 0.5rem;
    font-weight: 700;
  }
  @media (prefers-color-scheme: dark) {
    .eyebrow {
      color: #ff987c;
    }
    a {
      background: #f2eee3;
      color: #1c1b19;
    }
  }
</style>
