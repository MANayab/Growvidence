---
import { buildPageMetadata, buildStructuredData } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;
const siteUrl = Astro.site?.toString() ?? "https://manayab.github.io";
const basePath = import.meta.env.BASE_URL;
const pagePath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname
  : `${basePath}${Astro.url.pathname.replace(/^\/+/, "")}`;
const metadata = buildPageMetadata({
  title,
  description,
  pathname: pagePath,
  siteUrl,
  indexable,
});
const projectUrl = new URL(basePath, siteUrl).toString();
const structuredData = buildStructuredData(projectUrl);
const jsonLd = [structuredData.organization, structuredData.website];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="keywords" content={metadata.keywords} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Growvidence" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={metadata.canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    {jsonLd.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <a
        class="brand"
        href={import.meta.env.BASE_URL}
        aria-label="Growvidence home"
      >
        <span class="brand-mark" aria-hidden="true">
          G
        </span>
        <span>Growvidence</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${import.meta.env.BASE_URL}#how-it-works`}>How it works</a>
        <a href={`${import.meta.env.BASE_URL}#principles`}>Principles</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Growvidence is a learning project concept. Task completion is not proof
        of mastery.
      </p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    color-scheme: light dark;
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #f2eee3;
    color: #1c1b19;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.6;
  }
  :global(a) {
    color: inherit;
  }
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -5rem;
    z-index: 10;
    padding: 0.7rem 1rem;
    background: #1c1b19;
    color: white;
    border-radius: 0.4rem;
  }
  .skip-link:focus {
    top: 1rem;
  }
  .site-header {
    max-width: 1120px;
    margin: auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    font-weight: 800;
    text-decoration: none;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.65rem;
    background: #c8431f;
    color: white;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  nav a {
    text-decoration: none;
    font-weight: 600;
  }
  nav a:hover,
  nav a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  :global(main) {
    min-height: 70vh;
  }
  .site-footer {
    max-width: 1120px;
    margin: 3rem auto 0;
    padding: 1.5rem;
    border-top: 1px solid #aaa397;
    color: #514d46;
    font-size: 0.9rem;
  }
  @media (prefers-color-scheme: dark) {
    :global(body) {
      background: #171715;
      color: #f2eee3;
    }
    .site-footer {
      border-color: #4a4842;
      color: #c5bfb3;
    }
    .brand-mark {
      color: #171715;
    }
  }
  @media (max-width: 520px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }
    nav {
      gap: 0.9rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
