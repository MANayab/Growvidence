{
  "name": "growvidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.7.0", "npm": ">=11.19.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx}\" \"*.{json,js,mjs}\" \".github/workflows/*.yml\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx}\" \"*.{json,js,mjs}\" \".github/workflows/*.yml\" \"scripts/**/*.mjs\"",
    "check": "astro check",
    "test": "vitest run",
    "verify-build": "node scripts/verify-build.mjs",
    "bundle-size": "node scripts/check-app-bundle.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.12",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.0.5"
  }
}
