{
  "name": "growvidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{astro,ts}\" \"*.{json,js,mjs}\" \".github/workflows/*.yml\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts}\" \"*.{json,js,mjs}\" \".github/workflows/*.yml\" \"scripts/**/*.mjs\"",
    "check": "astro check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "astro": "7.4.12",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.0.5"
  }
}
